add(a, b) {
    return a + b
}
main() {
    conda a = "Hello, "
    conda b = "Z"
    bool enabled = true
    box n = 2;
    print a + b, "\n"
    if (enabled == true) {
        print(add(10, 20), "\n")
    }
    while (n > 0) {
        print(n, "\n")
        n = n - 1
    }
    if (n >= 0) {
        complex c = complex(3, 4)
        print(c, "\n")
    }
    for i in +(2) {
        print(i, "\n")
    }
}
